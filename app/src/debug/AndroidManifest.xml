<?xml version="1.0" encoding="utf-8"?>
<!-- Debug and dev only: the agent AppFunctions, see docs/testing/agent-app-functions.md -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The library's minSdk is 24. Its code only runs on Android 16+, where the system binds
         the service, so these builds can still install on 23. -->
    <uses-sdk tools:overrideLibrary="androidx.appfunctions" />

    <application>
        <!-- Generated by the AppFunctions compiler from AgentAppFunctions -->
        <service
            android:name="org.greenstand.android.TreeTracker.appfunctions.AgentAppFunctionService"
            android:exported="true"
            android:permission="android.permission.BIND_APP_FUNCTION_SERVICE"
            tools:targetApi="36">
            <property
                android:name="android.app.appfunctions.schema"
                android:value="app_functions_schema.xsd" />
            <property
                android:name="android.app.appfunctions.v2"
                android:value="agent_app_functions.xml" />
            <intent-filter>
                <action android:name="android.app.appfunctions.AppFunctionService" />
            </intent-filter>
        </service>
    </application>
</manifest>
